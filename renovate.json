{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/Chihuahua",
  "dependencyDashboard": {
    "enabled": true
  },
  "prConcurrentLimit": 4,
  "branchConcurrentLimit": 4,
  "automerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the NeoForge build version for Minecraft 1.21.1",
      "managerFilePatterns": ["/^gradle\\.properties$/"],
      "matchStrings": ["neo_version=(?<currentValue>\\d+(?:\\.\\d+){2})"],
      "autoReplaceStringTemplate": "neo_version={{{newValue}}}",
      "depNameTemplate": "net.neoforged:neoforge",
      "packageNameTemplate": "net.neoforged:neoforge",
      "datasourceTemplate": "maven",
      "registryUrlTemplate": "https://maven.neoforged.net/releases/",
      "versioningTemplate": "maven"
    }
  ],
  "packageRules": [
    {
      "description": "Keep NeoForge updates on the Minecraft 1.21.1 line for manual review",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["net.neoforged:neoforge"],
      "allowedVersions": "/^21\\.1\\./",
      "groupName": "NeoForge 1.21.1"
    },
    {
      "description": "Group Gradle plugin updates for one review",
      "matchManagers": ["gradle"],
      "matchDepTypes": ["plugin"],
      "groupName": "Gradle plugins"
    },
    {
      "description": "Keep Iris updates on the Minecraft 1.21.1 NeoForge line",
      "matchManagers": ["gradle"],
      "matchDepNames": ["maven.modrinth:iris"],
      "allowedVersions": "/\\+1\\.21\\.1-neoforge$/"
    },
    {
      "description": "Keep Jade updates on the Minecraft 1.21.1 line",
      "matchManagers": ["gradle"],
      "matchDepNames": ["maven.modrinth:jade"],
      "allowedVersions": "/^15\\./"
    },
    {
      "description": "Keep Java pinned to JDK 21 for Minecraft 1.21.1 / NeoForge 21.1",
      "matchDepNames": ["java-jdk"],
      "allowedVersions": "/^21(\\b|\\.)/"
    },
    {
      "description": "Keep Gradle on 8.x for ModDevGradle/Pitest compatibility",
      "matchDepNames": ["gradle"],
      "allowedVersions": "/^8\\./"
    },
    {
      "description": "Keep spark pinned to Java 21 / MC 1.21.1 compatible version",
      "matchManagers": ["gradle"],
      "matchDepNames": ["maven.modrinth:spark"],
      "enabled": false
    }
  ]
}
